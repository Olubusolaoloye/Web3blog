{
  "name": "hashline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "eslint .",
    "typecheck": "react-router typegen && tsc && pnpm --filter studio typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "sanity:typegen": "pnpm --filter studio typegen",
    "db:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@portabletext/react": "^4.0.3",
    "@portabletext/types": "^4.0.2",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-router/node": "7.18.5",
    "@react-router/serve": "7.18.5",
    "@resvg/resvg-js": "^2.6.2",
    "@sanity/client": "^7.28.0",
    "@sanity/image-url": "^1.2.0",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "groq": "^6.22.0",
    "isbot": "^5.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "7.18.5",
    "satori": "^0.63.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "7.18.5",
    "@react-router/fs-routes": "7.18.5",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.14.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
