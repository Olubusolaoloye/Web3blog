{
  "name": "studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "typecheck": "tsc --noEmit",
    "schema:extract": "sanity schema extract --path ./schema.json",
    "typegen": "sanity schema extract --path ./schema.json && sanity typegen generate",
    "seed:export": "node scripts/export-seed.ts",
    "seed": "node scripts/export-seed.ts && sanity dataset import seed/seed.ndjson production --replace"
  },
  "dependencies": {
    "@sanity/vision": "3.99.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "3.99.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "typescript": "~5.9.3"
  }
}
